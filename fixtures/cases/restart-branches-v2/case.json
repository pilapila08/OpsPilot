      "contradiction_signals": ["liveness.ready_without_restart"],
      "expected_diagnosis": {
        "status": "PARTIAL",
        "root_cause": "The observed Pod is healthy; a liveness-triggered restart is not established.",
        "recommendation": "Check whether the request refers to a different Pod or time window.",
        "claim": {
          "claim_id": "claim_healthy_pod",
          "text": "The current Pod is ready with no restarts.",
          "evidence_ids": ["ev_healthy_status"],
          "inference_confidence": 0.9
