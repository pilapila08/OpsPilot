        "verification": {
          "claim_id": "claim_healthy_pod",
          "supported": false,
          "verification_confidence": 0.9,
          "checked_evidence_ids": ["ev_healthy_status"],
          "missing_evidence": [
            {
              "requirement": "liveness.restart",
              "reason": "No liveness-triggered restart was observed."
            }
          ],
          "contradictions": [
            {
              "evidence_ids": ["ev_healthy_status"],
              "reason": "A ready Pod with zero restarts contradicts this liveness failure hypothesis."
            }
